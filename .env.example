PORT=3001
DATABASE_PATH=storage/eduforge.db
# Backend only. Never use VITE_ for API credentials.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional, backend-only read access to authorized GitHub repositories.
GITHUB_TOKEN=
# Google OAuth, backend only. Use a dedicated client with Drive/Docs APIs enabled.
# Register this exact redirect URI. Open the app at http://127.0.0.1:5173.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/google/callback
EDUFORGE_PUBLIC_URL=http://127.0.0.1:5173
# A persistent, random 32-byte key encoded in base64. Keep with your secure backup.
GOOGLE_TOKEN_KEY=
